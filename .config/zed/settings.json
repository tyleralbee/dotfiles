{
    "active_pane_modifiers": { "inactive_opacity": 0.75 },
    "agent": {
        "commit_message_model": { "provider": "openai", "model": "gpt-5.5" },
        "dock": "right",
        "enable_feedback": false,
        "show_turn_stats": true,
        "sidebar_side": "right",
        "thinking_display": "preview",
        "use_modifier_to_send": true,
    },
    "agent_servers": {
        "codex-acp": {
            "default_config_options": {
                "reasoning_effort": "xhigh",
                "mode": "agent",
                "model": "gpt-5.6-sol"
            },
            "type": "registry"
        }
    },
    "autosave": { "after_delay": { "milliseconds": 1000 } },
    "base_keymap": "VSCode",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 12,
    "cli_default_open_behavior": "existing_window",
    "collaboration_panel": { "button": false },
    "current_line_highlight": "gutter",
    "debugger": { "button": false, "dock": "left" },
    "diagnostics": { "button": false },
    "diff_view_style": "unified",
    "edit_predictions": {
        "allow_data_collection": "no",
        "copilot": { "enable_next_edit_suggestions": false },
        "provider": "copilot"
    },
    "file_types": {
        // https://github.com/kartikvashistha/zed-ansible?tab=readme-ov-file#filetype-detection
        "Ansible": [
            "**.ansible.yml",
            "**.ansible.yaml",
            "**/defaults/*.yml",
            "**/defaults/*.yaml",
            "**/meta/*.yml",
            "**/meta/*.yaml",
            "**/tasks/*.yml",
            "**/tasks/*.yaml",
            "**/handlers/*.yml",
            "**/handlers/*.yaml",
            "**/group_vars/*.yml",
            "**/group_vars/*.yaml",
            "**/playbooks/*.yaml",
            "**/playbooks/*.yml",
            "**playbook*.yaml",
            "**playbook*.yml"
        ],
        "env": [".env*"],
        "Hyprland Config": ["**/hypr/*.conf"],
        "JSON": [".prettierrc"]
    },
    "git": { "inline_blame": { "show_commit_summary": true } },
    "git_panel": { "commit_title_max_length": 50, "dock": "left", "tree_view": true },
    "languages": {
        "env": { "show_edit_predictions": false },
        "LOG": { "show_edit_predictions": false },
        "Markdown": { "soft_wrap": "editor_width" }
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": { "enabled": "always" }
                },
                "javascript": {
                    "updateImportsOnFileMove": { "enabled": "always" }
                }
            },
            "enable_lsp_tasks": true
        }
    },
    "middle_click_paste": false,
    "outline_panel": { "button": false, "dock": "left" },
    "preview_tabs": { "enable_keep_preview_on_code_navigation": true },
    "project_panel": {
        "auto_fold_dirs": false,
        "dock": "left",
        "entry_spacing": "standard",
        "folder_icons": false,
        "hide_root": true,
        "indent_guides": { "show": "never" },
        "indent_size": 10,
        "sticky_scroll": false
    },
    "search": {
        "button": false,
        "case_sensitive": true,
        "regex": false,
        "whole_word": false
    },
    "soft_wrap": "none",
    "status_bar": { "cursor_position_button": false },
    "tab_bar": { "show_pinned_tabs_in_separate_row": true },
    "tab_size": 4,
    "tabs": { "git_status": true, "show_diagnostics": "all" },
    "telemetry": { "diagnostics": true, "metrics": false },
    "terminal": { "button": false, "copy_on_select": true, "font_family": "JetBrainsMono Nerd Font", "font_size": 12 },
    "theme": { "mode": "system", "light": "Ayu Light", "dark": "Ayu Dark" },
    "title_bar": { "show_user_picture": false },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "ui_font_family": "JetBrainsMono Nerd Font",
    "ui_font_size": 12,
    "use_autoclose": false,
    "use_smartcase_search": true,
    "vim": {
        "highlight_on_yank_duration": 100,
        "toggle_relative_line_numbers": true,
        "use_smartcase_find": true,
        "use_system_clipboard": "always"
    },
    "vim_mode": true
}
