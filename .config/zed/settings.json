{
    "active_pane_modifiers": { "inactive_opacity": 0.75 },
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "use_modifier_to_send": true,
        "commit_message_model": { "provider": "openai", "model": "gpt-5.5" }
    },
    "agent_servers": {
        "codex-acp": {
            "default_config_options": {
                "reasoning_effort": "high",
                "mode": "auto",
                "model": "gpt-5.5"
            },
            "type": "registry"
        }
    },
    "autosave": { "after_delay": { "milliseconds": 1000 } },
    "base_keymap": "VSCode",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 12,
    "collaboration_panel": { "button": false },
    "current_line_highlight": "gutter",
    "debugger": { "dock": "left", "button": false },
    "diagnostics": { "button": false },
    "edit_predictions": {
        "copilot": { "enable_next_edit_suggestions": false },
        "provider": "copilot"
    },
    "file_types": {
        // https://github.com/kartikvashistha/zed-ansible?tab=readme-ov-file#filetype-detection
        "Ansible": [
            "**.ansible.yml",
            "**.ansible.yaml",
            "**/defaults/*.yml",
            "**/defaults/*.yaml",
            "**/meta/*.yml",
            "**/meta/*.yaml",
            "**/tasks/*.yml",
            "**/tasks/*.yaml",
            "**/handlers/*.yml",
            "**/handlers/*.yaml",
            "**/group_vars/*.yml",
            "**/group_vars/*.yaml",
            "**/playbooks/*.yaml",
            "**/playbooks/*.yml",
            "**playbook*.yaml",
            "**playbook*.yml"
        ],
        "env": [".env*"],
        "Hyprland Config": ["**/hypr/*.conf"],
        "JSON": [".prettierrc"]
    },
    "git": { "inline_blame": { "show_commit_summary": true } },
    "git_panel": { "dock": "left", "tree_view": true },
    "languages": {
        "env": { "show_edit_predictions": false },
        "LOG": { "show_edit_predictions": false },
        "Markdown": { "soft_wrap": "editor_width" }
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": { "enabled": "always" }
                },
                "javascript": {
                    "updateImportsOnFileMove": { "enabled": "always" }
                }
            },
            "enable_lsp_tasks": true
        }
    },
    "outline_panel": { "button": false, "dock": "left" },
    "preview_tabs": { "enable_keep_preview_on_code_navigation": true },
    "project_panel": {
        "auto_fold_dirs": false,
        "dock": "left",
        "entry_spacing": "standard",
        "folder_icons": false,
        "hide_root": true,
        "indent_guides": { "show": "never" },
        "indent_size": 10,
        "sticky_scroll": false
    },
    "search": {
        "button": false,
        "case_sensitive": true,
        "regex": false,
        "whole_word": false
    },
    "soft_wrap": "none",
    "status_bar": { "cursor_position_button": false },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "tab_size": 4,
    "tabs": { "git_status": true, "show_diagnostics": "all" },
    "telemetry": { "diagnostics": true, "metrics": false },
    "terminal": {
        "button": false,
        "font_family": "JetBrainsMono Nerd Font",
        "font_size": 12,
        "shell": {
            "with_arguments": {
                "program": "/bin/bash",
                "args": [
                    "-c",
                    "tmux new-session -A -s \"basename \"$(dirname \"$PWD\")\"\""
                ]
            }
        }
    },
    "theme": { "mode": "system", "light": "Ayu Light", "dark": "Ayu Dark" },
    "title_bar": { "show_project_items": false, "show_user_picture": false },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "ui_font_family": "JetBrainsMono Nerd Font",
    "ui_font_size": 12,
    "use_autoclose": false,
    "use_smartcase_search": true,
    "vim": {
        "highlight_on_yank_duration": 100,
        "toggle_relative_line_numbers": true,
        "use_smartcase_find": true,
        "use_system_clipboard": "always"
    },
    "vim_mode": true
}
